{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Publicly non-sensitive member profile stored in Firestore for studio attribution and role display.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the member."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name shown in studio and admin directory."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional Google avatar URL."
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"],
          "description": "Access role of the member."
        },
        "imageCount": {
          "type": "number",
          "description": "Total number of saved images created by this user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest profile activity."
        }
      },
      "required": ["uid", "displayName", "photoURL", "role", "imageCount", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record containing the member's verified email address and sign-in metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the parent user document."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google email address."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent sign-in."
        }
      },
      "required": ["uid", "email", "lastLoginAt"]
    },
    "GeneratedImage": {
      "title": "GeneratedImage",
      "description": "An AI-generated, edited, or animated artwork saved to a member's personal vault with version lineage and project restore JSON.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the image creator."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID mirrored for ownership queries."
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Creator display name."
        },
        "itemType": {
          "type": "string",
          "enum": ["generated", "edited", "animation"],
          "description": "Type of creative work in vault."
        },
        "sourceImageId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional parent image ID for version lineage tracking."
        },
        "albumId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional user album/folder ID."
        },
        "projectJson": {
          "type": "string",
          "maxLength": 250000,
          "description": "Serialized Canvas Studio layers, text, frames, and animation keyframes for reopening."
        },
        "originalPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Original prompt in any language entered by the user (supports unlimited/multi-section mode)."
        },
        "enhancedPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 25000,
          "description": "Structured English prompt generated by the Vision/Prompt Expert."
        },
        "stylePreset": {
          "type": "string",
          "enum": ["auto", "photorealistic", "fine-art", "3d-render", "flat-vector", "watercolor", "anime", "logo"],
          "description": "Visual style preset selected for generation."
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "16:9", "4:3", "3:4", "9:16", "custom"],
          "description": "Target image aspect ratio or custom pixel mode."
        },
        "dimensionsLabel": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional custom pixel dimension label (e.g., 1080x1350)."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "OpenRouter model identifier used for generation."
        },
        "imageDataUrl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 750000,
          "description": "PNG data URL stored safely within Firestore limits."
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the owner starred this image in their vault."
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "featured", "hidden"],
          "description": "Moderation and showcase visibility state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of image creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "ownerId",
        "ownerName",
        "originalPrompt",
        "enhancedPrompt",
        "stylePreset",
        "aspectRatio",
        "model",
        "imageDataUrl",
        "isFavorite",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Album": {
      "title": "Album",
      "description": "Personal folder/album created by a member to organize vault artworks.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the album owner."
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching ownerId."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Folder or album name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when album was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when album was last updated."
        }
      },
      "required": ["ownerId", "userId", "name", "createdAt", "updatedAt"]
    },
    "SavedPrompt": {
      "title": "SavedPrompt",
      "description": "Reusable AI prompt template saved by a member for unlimited-length studio workflows.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the prompt owner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Human-readable label for the saved prompt."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "Main prompt text."
        },
        "negativePrompt": {
          "type": "string",
          "maxLength": 4000,
          "description": "Optional negative prompt."
        },
        "stylePreset": {
          "type": "string",
          "enum": ["auto", "photorealistic", "fine-art", "3d-render", "flat-vector", "watercolor", "anime", "logo"],
          "description": "Selected style preset."
        },
        "photorealismPreset": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional photorealism preset key."
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["1:1", "16:9", "4:3", "3:4", "9:16", "custom"],
          "description": "Selected aspect ratio."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["ownerId", "title", "prompt", "stylePreset", "aspectRatio", "createdAt", "updatedAt"]
    },
    "StudioProject": {
      "title": "StudioProject",
      "description": "Saved multi-layer Editor or Video Timeline studio project snapshot owned by a member.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the project owner."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Project display title."
        },
        "kind": {
          "type": "string",
          "enum": ["editor", "decompose", "video"],
          "description": "Studio workspace category."
        },
        "projectJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 250000,
          "description": "Serialized project JSON payload."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when project was saved."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["ownerId", "title", "kind", "projectJson", "createdAt", "updatedAt"]
    },
    "UserRequest": {
      "title": "UserRequest",
      "description": "Daily user letter / feature request with 1-5 star rating displayed on Admin timeline.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the requester."
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the requester."
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "UTC/local date key YYYY-MM-DD enforcing one submission per user per day."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Letter subject or requested feature headline."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Freeform letter content to staff."
        },
        "rating": {
          "type": "number",
          "description": "User satisfaction star rating (1 to 5)."
        },
        "status": {
          "type": "string",
          "enum": ["submitted", "reviewed", "in-progress", "completed"],
          "description": "Timeline status managed by admins."
        },
        "adminNote": {
          "type": "string",
          "maxLength": 1000,
          "description": "Official admin response note on timeline."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when request was submitted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest timeline update."
        }
      },
      "required": [
        "authorId",
        "authorName",
        "dateKey",
        "subject",
        "message",
        "rating",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Member profile documents keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection storing verified email addresses, accessible only to the owner and admins."
    },
    "/images/{imageId}": {
      "schema": { "$ref": "#/entities/GeneratedImage" },
      "description": "AI-generated, edited, and animated artworks owned by members, queryable by ownerId/userId or featured visibility, and fully manageable by admins."
    },
    "/albums/{albumId}": {
      "schema": { "$ref": "#/entities/Album" },
      "description": "Member-owned folders/albums for organizing vault items."
    },
    "/savedPrompts/{promptId}": {
      "schema": { "$ref": "#/entities/SavedPrompt" },
      "description": "Saved unlimited-length prompt templates belonging to members."
    },
    "/studioProjects/{projectId}": {
      "schema": { "$ref": "#/entities/StudioProject" },
      "description": "Saved multi-layer Editor, Decompose, and Video Editor project snapshots belonging to members."
    },
    "/requests/{requestId}": {
      "schema": { "$ref": "#/entities/UserRequest" },
      "description": "Once-per-day feature requests and star ratings keyed by {uid}_{YYYY-MM-DD}, managed by admins on a chronological timeline."
    }
  }
}
